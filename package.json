{
  "name": "@yaorenliang/dsh-session-card",
  "version": "0.1.2",
  "description": "DeepSeek Harness 侧边栏会话行卡片：标题、你最后问的那句、运行中的子智能体与后台任务。",
  "type": "module",
  "license": "MIT",
  "author": "姚壬亮 <yaorenliang@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaorenliang/dsh-session-card.git"
  },
  "homepage": "https://github.com/yaorenliang/dsh-session-card",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "sidebar",
    "sessions",
    "notifications",
    "session-cards"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run && node scripts/build.mjs",
    "prepublishOnly": "pnpm verify"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.2",
    "happy-dom": "^21.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
